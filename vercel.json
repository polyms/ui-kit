{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm nx build web",
	"devCommand": "pnpm nx serve web",
	"framework": null,
	"git": {
		"deploymentEnabled": {
			"main": true
		}
	},
	"installCommand": "pnpm install",
	"outputDirectory": "dist/web",
	"rewrites": [
		{
			"destination": "/index.html",
			"source": "/(.*)"
		}
	]
}
